{
  "compilerOptions": {
  
    "target": "ES2022",
    "module": "ES2022",

 
    "moduleResolution": "node16",


    "rootDir": "src",
    "outDir": "dist",

 
    "sourceMap": true,
    "strict": false,

 
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
